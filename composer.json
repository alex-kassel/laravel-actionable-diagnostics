{
    "name": "alex-kassel/laravel-actionable-diagnostics",
    "description": "Multichannel diagnostic event engine, actionable exception taxonomy, event buffering, and AI agent remediation package for PHP 8.2+ and Laravel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Macenko",
            "email": "alexander.macenko@gmail.com"
        }
    ],
    "homepage": "https://github.com/alex-kassel/laravel-actionable-diagnostics",
    "support": {
        "issues": "https://github.com/alex-kassel/laravel-actionable-diagnostics/issues",
        "source": "https://github.com/alex-kassel/laravel-actionable-diagnostics"
    },
    "keywords": [
        "laravel",
        "diagnostics",
        "logging",
        "exceptions",
        "remediation",
        "monolog",
        "webhooks",
        "ai-agent"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/events": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "symfony/http-client": "^6.0 || ^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "AlexKassel\\LaravelActionableDiagnostics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlexKassel\\LaravelActionableDiagnostics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AlexKassel\\LaravelActionableDiagnostics\\Providers\\ActionableDiagnosticsServiceProvider"
            ],
            "aliases": {
                "Diagnostics": "AlexKassel\\LaravelActionableDiagnostics\\Facades\\Diagnostics"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
